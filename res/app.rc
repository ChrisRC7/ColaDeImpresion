// Recursos de la aplicación: ícono, manifiesto e información de versión.
// La información de versión se llena completa a propósito: un ejecutable sin
// metadatos (empresa, descripción, copyright) es más propenso a que SmartScreen
// o un antivirus lo traten como sospechoso.
// La versión (0.5.17) se actualiza a mano en cada versión, igual que
// CMakeLists.txt e installer\ColaDeImpresion.iss.
#include <windows.h>

// Ícono de la aplicación. El de id más bajo es el que muestra el Explorador
// para el .exe.
1 ICON "app.ico"

// Manifiesto incrustado (id 1): ejecución asInvoker (D15), DPI y estilos
// visuales de los controles comunes.
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

// Información de versión (Propiedades > Detalles del .exe). FILEVERSION y
// PRODUCTVERSION son numéricas (mayor, menor, revisión, compilación); los
// VALUE de texto son lo que se muestra.
VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,5,17,0
PRODUCTVERSION 0,5,17,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // Textos en español: 0C0A = español (alfabetización internacional),
        // 04B0 = 1200 (Unicode). Sin tildes para no depender de la página de
        // códigos con que rc.exe/windres leen este archivo.
        BLOCK "0C0A04B0"
        BEGIN
            VALUE "CompanyName", "ChrisCorp"
            VALUE "FileDescription", "Cola de Impresion - gestor de colas de impresion"
            VALUE "FileVersion", "0.5.17.0"
            VALUE "InternalName", "ColaDeImpresion"
            VALUE "LegalCopyright", "Copyright (C) 2026 ChrisCorp. Todos los derechos reservados."
            VALUE "LegalTrademarks", "ChrisCorp"
            VALUE "OriginalFilename", "ColaDeImpresion.exe"
            VALUE "ProductName", "Cola de Impresion"
            VALUE "ProductVersion", "0.5.17.0"
            VALUE "Comments", "Administra las colas de un servidor de impresion: ver, pausar, retener, cancelar, reordenar y previsualizar trabajos. Desarrollado por ChrisCorp para el LAIMI del Instituto Tecnologico de Costa Rica."
        END
        // Textos en inglés (0409 = inglés de EE. UU., Unicode).
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "ChrisCorp"
            VALUE "FileDescription", "Print Queue - print queue manager"
            VALUE "FileVersion", "0.5.17.0"
            VALUE "InternalName", "ColaDeImpresion"
            VALUE "LegalCopyright", "Copyright (C) 2026 ChrisCorp. All rights reserved."
            VALUE "LegalTrademarks", "ChrisCorp"
            VALUE "OriginalFilename", "ColaDeImpresion.exe"
            VALUE "ProductName", "Print Queue"
            VALUE "ProductVersion", "0.5.17.0"
            VALUE "Comments", "Manages the queues of a Windows print server: view, pause, hold, cancel, reorder and preview jobs. Built by ChrisCorp for LAIMI, Costa Rica Institute of Technology."
        END
    END
    // Idiomas disponibles (pares idioma, página de códigos); deben coincidir
    // con los bloques de StringFileInfo.
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0C0A, 1200, 0x0409, 1200
    END
END
